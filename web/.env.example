# Só é preciso na publicação, com a API noutro endereço. Em desenvolvimento não se usa este ficheiro:
# os pedidos a /api passam pelo Vite até à API local (ver vite.config.js).

# Endereço da API, sem barra no fim. Só as variáveis começadas por VITE_ chegam ao browser, por isso
# nunca colocar aqui segredos.
VITE_API_URL=https://api.exemplo.pt
