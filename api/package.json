{
  "name": "do-campo-a-mesa-api",
  "private": true,
  "version": "0.0.0",
  "description": "API REST do Do Campo à Mesa: mercado de produtores locais com leilões em tempo real",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "criar-admin": "node --env-file-if-exists=.env src/scripts/criarAdmin.js",
    "exemplo": "node --env-file-if-exists=.env src/scripts/exemplo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "swagger-ui-dist": "5.34.0"
  }
}
