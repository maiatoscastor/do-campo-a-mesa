# Copiar para .env e preencher. O ficheiro .env nunca vai para o Git.

# Porta em que a API fica à escuta
PORT=3000

# Endereço de ligação ao MongoDB Atlas, com o utilizador, a password e o nome da base de dados
MONGODB_URI=mongodb+srv://utilizador:password@cluster.xxxxx.mongodb.net/do-campo-a-mesa-dev

# Segredo que assina as sessões. Gerar um valor à sorte, diferente em cada ambiente:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duração de cada sessão
JWT_EXPIRES_IN=2h

# Endereço da aplicação web, a única autorizada a falar com a API
CLIENT_URL=http://localhost:5173

# Chave de leitura e escrita do Vercel Blob (o storage das imagens na Cloud). Sem ela, as imagens
# ficam na pasta api/uploads, como no computador. Na publicação é obrigatória: o disco do servidor
# apaga-se a cada nova versão.
BLOB_READ_WRITE_TOKEN=

# Quantos proxies há à frente da API (0 no computador). Na Cloud, onde outro servidor recebe os
# pedidos e os passa à API, é 1: assim os limites de tentativas contam pelo endereço de quem pede.
TRUST_PROXY=0

# RATE_LIMIT=off desliga os limites de tentativas. Só os testes automáticos o usam
# (test/testes.env): nunca no computador de desenvolvimento nem em produção.
